{
  "name": "secrets_and_crypto_rules",
  "source": "mega-analyzer curated (RE2-safe)",
  "rules": [
    {
      "id": "secret_aws_access_key_id",
      "title": "Hardcoded AWS Access Key ID",
      "severity": "critical",
      "cvss": 9.1,
      "cwe": "cwe-798",
      "owasp_mobile": "m9",
      "masvs": "storage-1",
      "ref": "https://cwe.mitre.org/data/definitions/798.html",
      "pattern_type": "regex",
      "pattern": "\\b(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA)[0-9A-Z]{16}\\b"
    },
    {
      "id": "secret_aws_secret_access_key",
      "title": "Possible hardcoded AWS Secret Access Key",
      "severity": "critical",
      "cvss": 9.1,
      "cwe": "cwe-798",
      "owasp_mobile": "m9",
      "masvs": "storage-1",
      "pattern_type": "regex_and",
      "patterns": [
        "(?i)aws[_.-]?(secret|sk)",
        "[\"'][A-Za-z0-9/+=]{40}[\"']"
      ]
    },
    {
      "id": "secret_google_api_key",
      "title": "Hardcoded Google API Key",
      "severity": "high",
      "cvss": 7.5,
      "cwe": "cwe-798",
      "owasp_mobile": "m9",
      "masvs": "storage-1",
      "pattern_type": "regex",
      "pattern": "\\bAIza[0-9A-Za-z_\\-]{35}\\b"
    },
    {
      "id": "secret_gcp_service_account",
      "title": "Google Cloud service account private key material",
      "severity": "critical",
      "cvss": 9.1,
      "cwe": "cwe-798",
      "owasp_mobile": "m9",
      "masvs": "storage-1",
      "pattern_type": "regex",
      "pattern": "\"type\"\\s*:\\s*\"service_account\""
    },
    {
      "id": "secret_firebase_db_url",
      "title": "Firebase Realtime Database URL exposed",
      "severity": "warning",
      "cvss": 5.3,
      "cwe": "cwe-200",
      "owasp_mobile": "m2",
      "masvs": "storage-2",
      "pattern_type": "regex",
      "pattern": "https://[a-z0-9.-]+\\.firebaseio\\.com"
    },
    {
      "id": "secret_private_key_block",
      "title": "Hardcoded private key (PEM/OpenSSH) embedded in app",
      "severity": "critical",
      "cvss": 9.8,
      "cwe": "cwe-321",
      "owasp_mobile": "m9",
      "masvs": "crypto-1",
      "ref": "https://cwe.mitre.org/data/definitions/321.html",
      "pattern_type": "regex",
      "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----"
    },
    {
      "id": "secret_github_token",
      "title": "Hardcoded GitHub access token",
      "severity": "critical",
      "cvss": 8.6,
      "cwe": "cwe-798",
      "owasp_mobile": "m9",
      "masvs": "storage-1",
      "pattern_type": "regex",
      "pattern": "\\b(?:ghp|gho|ghu|ghs|ghr|github_pat)_[0-9A-Za-z_]{20,}\\b"
    },
    {
      "id": "secret_slack_token",
      "title": "Hardcoded Slack token",
      "severity": "high",
      "cvss": 7.5,
      "cwe": "cwe-798",
      "owasp_mobile": "m9",
      "masvs": "storage-1",
      "pattern_type": "regex",
      "pattern": "\\bxox[baprs]-[0-9A-Za-z-]{10,}\\b"
    },
    {
      "id": "secret_stripe_live_key",
      "title": "Hardcoded Stripe live secret key",
      "severity": "critical",
      "cvss": 9.1,
      "cwe": "cwe-798",
      "owasp_mobile": "m9",
      "masvs": "storage-1",
      "pattern_type": "regex",
      "pattern": "\\b(?:sk|rk)_live_[0-9A-Za-z]{20,}\\b"
    },
    {
      "id": "secret_twilio_account_sid",
      "title": "Hardcoded Twilio Account SID",
      "severity": "high",
      "cvss": 6.5,
      "cwe": "cwe-798",
      "owasp_mobile": "m9",
      "masvs": "storage-1",
      "pattern_type": "regex",
      "pattern": "\\bAC[0-9a-fA-F]{32}\\b"
    },
    {
      "id": "secret_jwt_hardcoded",
      "title": "Hardcoded JSON Web Token (JWT) in source",
      "severity": "high",
      "cvss": 6.5,
      "cwe": "cwe-798",
      "owasp_mobile": "m9",
      "masvs": "storage-1",
      "pattern_type": "regex",
      "pattern": "\\beyJ[A-Za-z0-9_\\-]{8,}\\.eyJ[A-Za-z0-9_\\-]{8,}\\.[A-Za-z0-9_\\-]{8,}\\b"
    },
    {
      "id": "secret_generic_password_assignment",
      "title": "Hardcoded password assigned in source",
      "severity": "high",
      "cvss": 7.5,
      "cwe": "cwe-259",
      "owasp_mobile": "m9",
      "masvs": "storage-1",
      "ref": "https://cwe.mitre.org/data/definitions/259.html",
      "pattern_type": "regex_and_not",
      "patterns": [
        "(?i)(?:password|passwd|pwd|secret|passphrase)\\s*[:=]\\s*[\"'][^\"']{4,}[\"']"
      ],
      "not_patterns": [
        "(?i)[\"'](?:\\$\\{|@string/|null|password|changeme|xxxx|example|your[_-]?password|placeholder)[\"']?"
      ]
    },
    {
      "id": "secret_basic_auth_in_url",
      "title": "Credentials embedded in URL (basic auth)",
      "severity": "high",
      "cvss": 7.5,
      "cwe": "cwe-522",
      "owasp_mobile": "m9",
      "masvs": "storage-1",
      "pattern_type": "regex",
      "pattern": "https?://[A-Za-z0-9._%+-]+:[^@\\s/\"']{3,}@[A-Za-z0-9.-]+"
    },
    {
      "id": "crypto_weak_hash_md5_sha1",
      "title": "Weak cryptographic hash (MD5/SHA-1/MD2/MD4) used",
      "severity": "warning",
      "cvss": 5.3,
      "cwe": "cwe-327",
      "owasp_mobile": "m5",
      "masvs": "crypto-4",
      "ref": "https://cwe.mitre.org/data/definitions/327.html",
      "pattern_type": "regex",
      "pattern": "(?i)MessageDigest\\.getInstance\\(\\s*\"(?:MD5|MD2|MD4|SHA-?1)\""
    },
    {
      "id": "crypto_weak_cipher_des_rc4",
      "title": "Weak/broken cipher (DES/3DES/RC2/RC4/Blowfish) used",
      "severity": "high",
      "cvss": 6.5,
      "cwe": "cwe-327",
      "owasp_mobile": "m5",
      "masvs": "crypto-4",
      "pattern_type": "regex",
      "pattern": "(?i)Cipher\\.getInstance\\(\\s*\"(?:DES|DESede|RC2|RC4|ARC4|Blowfish)[^\"]*\""
    },
    {
      "id": "crypto_ecb_mode",
      "title": "Insecure ECB block cipher mode used",
      "severity": "high",
      "cvss": 6.5,
      "cwe": "cwe-327",
      "owasp_mobile": "m5",
      "masvs": "crypto-3",
      "pattern_type": "regex",
      "pattern": "(?i)Cipher\\.getInstance\\(\\s*\"[A-Z0-9]+/ECB/"
    },
    {
      "id": "crypto_static_iv",
      "title": "Static/hardcoded initialization vector (IV) for cipher",
      "severity": "warning",
      "cvss": 5.9,
      "cwe": "cwe-329",
      "owasp_mobile": "m5",
      "masvs": "crypto-2",
      "pattern_type": "regex_and",
      "patterns": [
        "IvParameterSpec\\s*\\(",
        "(?i)(?:new byte\\[\\]\\s*\\{|getBytes\\(|\"[0-9a-fA-F]{16,}\")"
      ]
    },
    {
      "id": "crypto_insecure_random",
      "title": "Insecure PRNG (java.util.Random) used for security-sensitive value",
      "severity": "low",
      "cvss": 4.3,
      "cwe": "cwe-330",
      "owasp_mobile": "m5",
      "masvs": "crypto-6",
      "ref": "https://cwe.mitre.org/data/definitions/330.html",
      "pattern_type": "regex_and",
      "patterns": [
        "new\\s+java\\.util\\.Random\\s*\\(|new\\s+Random\\s*\\(",
        "(?i)(?:token|nonce|salt|iv|key|password|otp|secret|session)"
      ]
    },
    {
      "id": "crypto_rsa_no_padding",
      "title": "RSA used with NoPadding / PKCS1 (padding oracle risk)",
      "severity": "warning",
      "cvss": 5.9,
      "cwe": "cwe-780",
      "owasp_mobile": "m5",
      "masvs": "crypto-3",
      "pattern_type": "regex",
      "pattern": "(?i)Cipher\\.getInstance\\(\\s*\"RSA/(?:None|ECB)/(?:NoPadding|PKCS1Padding)\""
    },
    {
      "id": "crypto_hardcoded_secret_key_spec",
      "title": "Hardcoded symmetric key passed to SecretKeySpec",
      "severity": "high",
      "cvss": 7.4,
      "cwe": "cwe-321",
      "owasp_mobile": "m9",
      "masvs": "crypto-1",
      "pattern_type": "regex",
      "pattern": "SecretKeySpec\\s*\\(\\s*\"[^\"]{4,}\"\\.getBytes"
    }
  ]
}
