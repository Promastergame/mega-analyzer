# Mega-Analyzer — Docker Compose and Local Environment Configuration.
#
# WHY DO WE NEED A .env FILE?
#   These are local secrets and settings for `docker-compose.yml`. The Go core
#   binary reads environment variables directly from the host or container via
#   os.Getenv (see pkg/api/config.go). Docker Compose automatically picks up `.env`
#   from the root of the repository and injects values into the container services.
#
#   - MEGA_ANALYZER_API_TOKEN -> required when the API is exposed on non-loopback
#     interfaces or in Docker; the API service will refuse to start without it.
#   - POSTGRES_PASSWORD -> optional database password, only needed for `--profile postgres`.
#   - REDIS_PASSWORD -> optional Redis cache password, only needed for `--profile redis`.
#
# QUICK START:
#   cp .env.example .env
#   # Generate a strong token, e.g.: openssl rand -hex 32
#   docker compose up -d
#
# OPTIONAL PROFILES (PostgreSQL / Redis):
#   docker compose --profile postgres up -d
#   docker compose --profile redis up -d
#
# LOCAL RUN (without Docker):
#   Set environment variables directly in your shell:
#     $env:MEGA_ANALYZER_API_TOKEN="your-secret-token"   # Windows PowerShell
#     export MEGA_ANALYZER_API_TOKEN="your-secret-token" # Linux / macOS bash
#     ./analyzer -api -api-port 5000
#
# Note: Mega-Analyzer core does not require PostgreSQL or Redis to function;
# they are optional supporting services for custom deployment orchestration.
# See docs/DOCKER_DEPLOYMENT.md for complete deployment guides.

# Required API access token (e.g. generate with: openssl rand -hex 32)
MEGA_ANALYZER_API_TOKEN=

# PostgreSQL password — only required when using `--profile postgres`
POSTGRES_PASSWORD=

# Redis password — only required when using `--profile redis`
REDIS_PASSWORD=
