# Mega-Analyzer — Конфигурация окружения для Docker Compose и локального запуска.
#
# ЗАЧЕМ НУЖЕН .env?
#   Это локальные секреты и параметры для `docker-compose.yml`. Сам Go-код
#   читает переменные окружения напрямую из системы/контейнера через os.Getenv
#   (см. pkg/api/config.go). Docker Compose автоматически подхватывает файл `.env`
#   из корня репозитория и передаёт значения в контейнеры сервисов.
#
#   - MEGA_ANALYZER_API_TOKEN -> обязателен при запуске API на внешних интерфейсах
#     или в Docker; без токена API-сервис откажется стартовать в целях безопасности.
#   - POSTGRES_PASSWORD -> пароль к базе данных, нужен только для `--profile postgres`.
#   - REDIS_PASSWORD -> пароль к Redis, нужен только для `--profile redis`.
#
# БЫСТРЫЙ СТАРТ:
#   cp .env.example_ru .env
#   # Сгенерируйте надежный токен, например: openssl rand -hex 32
#   docker compose up -d
#
# ДОПОЛНИТЕЛЬНЫЕ ПРОФИЛИ (PostgreSQL / Redis):
#   docker compose --profile postgres up -d
#   docker compose --profile redis up -d
#
# БЕЗ DOCKER (локальный запуск в терминале):
#   Задайте переменную напрямую в вашей командной строке:
#     $env:MEGA_ANALYZER_API_TOKEN="ваш-секретный-токен"   # Windows PowerShell
#     export MEGA_ANALYZER_API_TOKEN="ваш-секретный-токен" # Linux / macOS bash
#     ./analyzer -api -api-port 5000
#
# Примечание: для базовой работы анализатора PostgreSQL и Redis НЕ требуются
# (у анализатора собственная встроенная база и кеш). Они нужны только для
# внешней оркестрации. См. docs/DOCKER_DEPLOYMENT.ru.md.

# Обязательный токен доступа к API (например, сгенерируйте: openssl rand -hex 32)
MEGA_ANALYZER_API_TOKEN=

# Пароль PostgreSQL — нужен только при использовании профиля `--profile postgres`
POSTGRES_PASSWORD=

# Пароль Redis — нужен только при использовании профиля `--profile redis`
REDIS_PASSWORD=
